node_modules/
dist/
# A build output like dist/, written to the root because the kit resolver reads kit-manifest.json
# at the top of the package only (design_source.py _load_package), never through exports.
/kit-manifest.json
test-results/
playwright-report/
*.tgz
.env
.DS_Store
# claude plugin eval writes its results next to the cases unless --output-dir is given.
plugins/**/evals/results/
__pycache__/
# Session-local working state (handoffs, review records); committing one is a per-file opt-in.
var/
