    { "fg": "--mq-border", "bg": "--mq-surface-alt", "use": "decorative", "note": "Table header rule carries no information" },
    { "fg": "--mq-border-light", "bg": "--mq-canvas", "use": "decorative", "note": "Hairlines carry no information" },
