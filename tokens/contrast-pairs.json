    { "fg": "--mq-on-navy-title", "bg": ["--mq-on-navy-pill", "--mq-panel-start"], "use": "text", "note": "Owner ruling 2: white icon inside an icon pill on the lighter panel stop" },
    { "fg": "--mq-chart-series-4", "bg": "--mq-chart-rest", "use": "decorative", "note": "Outline that separates the remainder fill from series 4 under colour-vision deficiency; the fill itself carries the information" }
  ]
}
